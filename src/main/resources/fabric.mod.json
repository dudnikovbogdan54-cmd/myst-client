{
  "schemaVersion": 1,
  "id": "mystclient",
  "version": "${version}",
  "name": "Mist Visuals",
  "description": "Purple-themed client interface with local Streamer Mode and a modular visual settings menu.",
  "authors": ["Aloxmyst_YT"],
  "icon": "assets/mystclient/icon.png",
  "contact": {
    "sources": "https://github.com/dudnikovbogdan54-cmd/myst-client"
  },
  "environment": "client",
  "entrypoints": {
    "client": ["dev.myst.client.MystClient"]
  },
  "mixins": ["mystclient.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "custom": {
    "modmenu": {
      "summaryTranslation": "modmenu.summaryTranslation.mystclient",
      "descriptionTranslation": "modmenu.descriptionTranslation.mystclient"
    }
  }
}
